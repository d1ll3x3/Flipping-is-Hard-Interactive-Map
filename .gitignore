node_modules/

# Intermediate export: hundreds of MB of ripped meshes and textures, rebuildable from the
# game with tools/rip-assets.mjs. Only raw/scene.json is worth keeping (see below).
raw/*
!raw/scene.json
# Collected by hand in a live game - not something a rebuild recovers.
!raw/npcs.json
!raw/npc-scene.json

# AssetRipper is downloaded, not authored.
tools/AssetRipper/
tools/AssetRipper_win_x64.zip
tools/assetripper.log

# Build output
web/dist/

# Mod build
mod/bin/
mod/obj/

# Workers. .wrangler holds a cache of the Cloudflare account it deploys to, and .dev.vars
# the local secrets for `wrangler dev` - the deployed Workers use `wrangler secret put`.
.wrangler/
.dev.vars
